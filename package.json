{
  "name": "loot-pixel-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel-art loot-card opener: collect 30 armor pieces across six sets. Canvas 2D, no runtime dependencies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/export-artifact.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "test:golden:update": "playwright test tests/golden.spec.js --update-snapshots",
    "bench": "node scripts/bench.mjs",
    "sprites": "python3 tools/sprites/extract.py",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.config.js\" index.html",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.config.js\" index.html",
    "lint": "eslint .",
    "test:dist": "npm run build && node scripts/test-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
