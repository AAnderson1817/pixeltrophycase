 }
+
+// added: run only the APU for one NTSC frame's worth of time (main CPU frozen)
+void snes_runApuOnlyFrame(Snes* snes) {
+  double cyc = (snes->palTiming ? apuCyclesPerMasterPal : apuCyclesPerMaster) * 357366.0;
+  snes->apuCatchupCycles += cyc;
+  int ran = apu_runCycles(snes->apu, (int) snes->apuCatchupCycles);
+  snes->apuCatchupCycles -= ran;
+}
